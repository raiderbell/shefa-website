---
import EntityLayout from '../../layouts/EntityLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import SectionRule from '../../components/SectionRule.astro';
import CardGrid from '../../components/CardGrid.astro';
import Callout from '../../components/Callout.astro';
---
<EntityLayout
  title="Investment"
  entityName="SHEFA INVESTMENT GROUP"
  tagline="Real estate and small-business acquisitions"
  description="Shefa Investment Group acquires real estate and small businesses with disciplined underwriting, long-term orientation, and an operator's eye for what compounds."
>

  <HeroSection
    headline="We Buy. We Build. We Hold."
    body="Shefa Investment Group acquires real estate and small businesses with disciplined underwriting, long-term orientation, and an operator's eye for what compounds."
    ctaSecondaryLabel="Our Approach"
    ctaSecondaryHref="/investment/approach"
    ctaLabel="Partner With Us"
    ctaHref="/investment/partner-with-us"
  />

  <div class="page-inner">
    <section class="section">
      <SectionRule number="01" title="WHAT WE LOOK FOR" />
      <CardGrid columns={3}>
        <div class="criterion-card">
          <h3>Real Estate</h3>
          <p>Single-family, multifamily, and commercial acquisitions. Cash-flow-first underwriting.</p>
        </div>
        <div class="criterion-card">
          <h3>Small Business</h3>
          <p>Owner-operated businesses with durable cash flow, motivated sellers, and room to systematize.</p>
        </div>
        <div class="criterion-card">
          <h3>Acquisition Criteria</h3>
          <p>Conservative underwriting. Long-term hold. No speculative flips.</p>
        </div>
      </CardGrid>
    </section>

    <section class="section">
      <Callout variant="gold">
        <p>We underwrite conservatively, hold with conviction, and never compete on price. Premium positioning is a hard rule.</p>
      </Callout>
    </section>

    <section class="section cta-section">
      <h2 class="cta-heading">Ready to explore a partnership?</h2>
      <a href="/investment/partner-with-us" class="btn-gold">Start the Conversation</a>
    </section>
  </div>

</EntityLayout>

<style>
  .criterion-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 28px;
  }

  .criterion-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 12px;
  }

  .criterion-card p {
    font-size: 0.88rem;
    color: var(--text-2);
    line-height: 1.6;
  }

  .cta-section {
    text-align: center;
    padding-bottom: 80px;
  }

  .cta-heading {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 28px;
  }

  .btn-gold {
    display: inline-block;
    background: var(--gold);
    color: var(--navy);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 14px 32px;
    border-radius: 2px;
    transition: opacity 0.2s;
  }

  .btn-gold:hover {
    opacity: 0.85;
  }
</style>
