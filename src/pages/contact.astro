---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/SectionRule.astro';
import IntakeForm from '../components/IntakeForm.astro';
---
<BaseLayout title="Contact" description="Tell us what you're working on. We'll route your message to the right person.">

  <div class="page-inner">
    <section class="section">
      <SectionRule title="LET'S TALK" />
      <p class="page-intro">Tell us what you're working on. We'll connect you with the right member of our team.</p>
      <div class="form-wrap">
        <IntakeForm entity="contact" />
      </div>
    </section>
  </div>

</BaseLayout>

<style>
  .page-intro {
    font-size: 1rem;
    color: var(--text-2);
    max-width: 520px;
    line-height: 1.7;
    margin-top: -20px;
    margin-bottom: 40px;
  }

  .form-wrap {
    max-width: 800px;
    padding-bottom: 80px;
  }
</style>
