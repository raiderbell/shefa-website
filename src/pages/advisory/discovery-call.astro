---
import EntityLayout from '../../layouts/EntityLayout.astro';
import SectionRule from '../../components/SectionRule.astro';
import Callout from '../../components/Callout.astro';
---
<EntityLayout
  title="Discovery Call"
  entityName="SHEFA ADVISORY GROUP"
  tagline="Fractional COO and CRO consulting"
>

  <div class="page-inner">
    <section class="section">
      <SectionRule title="BOOK A DISCOVERY CALL" />
      <div class="discovery-content">
        <p class="intro">30 minutes. No pitch. Just an honest conversation about your business and whether we're the right fit.</p>

        <div class="what-to-expect">
          <h3>What to expect</h3>
          <ul>
            <li>You share where the friction is — operations, revenue, or both</li>
            <li>We ask questions to understand the context</li>
            <li>We tell you honestly whether we can help and what that looks like</li>
            <li>If there's a fit, we scope an engagement — no obligation</li>
          </ul>
        </div>

        <Callout variant="navy">
          <p>We don't do discovery calls to sell. We do them to decide whether we should work together. That distinction matters.</p>
        </Callout>

        <div class="cta-block">
          <h3>Ready to talk?</h3>
          <p>Email us directly to schedule. We respond within one business day.</p>
          <a href="/contact?inquiry=advisory" class="btn-gold">Send Us a Message</a>
          <p class="note">Include a sentence about what you're working on and we'll suggest a time.</p>
        </div>
      </div>
    </section>
  </div>

</EntityLayout>

<style>
  .discovery-content {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-bottom: 80px;
  }

  .intro {
    font-size: 1.05rem;
    color: var(--text-2);
    line-height: 1.7;
    margin-top: -20px;
  }

  .what-to-expect h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 16px;
  }

  .what-to-expect ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .what-to-expect li {
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.6;
    padding-left: 20px;
    position: relative;
  }

  .what-to-expect li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--gold);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .cta-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cta-block h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
  }

  .cta-block > p {
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.6;
    margin: 0;
  }

  .btn-gold {
    display: inline-block;
    background: var(--gold);
    color: var(--navy);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 12px 28px;
    border-radius: 2px;
    transition: opacity 0.2s;
    align-self: flex-start;
  }

  .btn-gold:hover { opacity: 0.85; }

  .note {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-mute);
    letter-spacing: 0.03em;
  }
</style>
