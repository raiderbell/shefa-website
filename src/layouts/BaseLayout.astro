---
import ChromeHeader from '../components/ChromeHeader.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  footerDisclaimer?: string;
}

const {
  title,
  description = 'Shefa Group — purpose-driven operating company building scalable businesses and the people who run them.',
  footerDisclaimer,
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta http-equiv="Content-Security-Policy"
      content="default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src https://api.web3forms.com; font-src 'self'; frame-ancestors 'none';" />
    <title>{title} — Shefa Group</title>
    <link rel="icon" type="image/png" href="/images/shefa-logo.png" />
    <slot name="head" />
  </head>
  <body>
    <ChromeHeader />
    <main>
      <slot />
    </main>
    <Footer disclaimer={footerDisclaimer} />
    <CookieBanner />
  </body>
</html>

<style is:global>
  /* Persist theme before first paint to prevent flash */
  html[data-theme="dark"] { color-scheme: dark; }
  html[data-theme="light"] { color-scheme: light; }
</style>

<script>
  const saved = localStorage.getItem('shefa-theme');
  if (saved === 'light') {
    document.documentElement.setAttribute('data-theme', 'light');
  }
</script>
