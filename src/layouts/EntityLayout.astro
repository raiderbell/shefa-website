---
import BaseLayout from './BaseLayout.astro';
import EntitySubHeader from '../components/EntitySubHeader.astro';

interface Props {
  title: string;
  entityName: string;
  tagline: string;
  description?: string;
}

const { title, entityName, tagline, description } = Astro.props;

const isInvestment = entityName.toLowerCase().includes('investment');
const footerDisclaimer = isInvestment
  ? 'Shefa Investment Group does not offer securities. Nothing on this site constitutes investment advice or an offer to sell any security or investment product.'
  : undefined;
---
<BaseLayout title={title} description={description} footerDisclaimer={footerDisclaimer}>
  <slot name="head" slot="head" />
  <EntitySubHeader entityName={entityName} tagline={tagline} />
  <slot />
</BaseLayout>
