---
interface Props {
  name: string;
  role: string;
  bio: string;
  tags?: string[];
  career?: string;
  photo?: string;
  initial: string;
}
const { name, role, bio, tags = [], career, photo, initial } = Astro.props;
---
<div class="bio-card">
  <div class="bio-photo">
    {photo
      ? <img src={photo} alt={`${name} — ${role}`} />
      : <div class="bio-initial" aria-hidden="true">{initial}</div>
    }
  </div>
  <div class="bio-content">
    <div class="bio-rule"></div>
    <p class="bio-role label">{role}</p>
    <h2 class="bio-name">{name}</h2>
    <p class="bio-text">{bio}</p>
    {tags.length > 0 && (
      <p class="bio-tags">{tags.join(' · ')}</p>
    )}
    {career && (
      <p class="bio-career">{career}</p>
    )}
  </div>
</div>

<style>
  .bio-card {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
    align-items: start;
    padding: 48px 0;
    border-bottom: 1px solid var(--border);
  }

  .bio-card:last-child {
    border-bottom: none;
  }

  .bio-photo {
    width: 240px;
    height: 300px;
    background: var(--surface-2);
    overflow: hidden;
    flex-shrink: 0;
  }

  .bio-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bio-initial {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5rem;
    font-weight: 700;
    color: var(--border-2);
  }

  .bio-rule {
    width: 40px;
    height: 1.5px;
    background: var(--gold);
    margin-bottom: 12px;
  }

  .bio-role {
    margin-bottom: 8px;
  }

  .bio-name {
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 16px;
    line-height: 1.1;
  }

  .bio-text {
    font-size: 1rem;
    color: var(--text-2);
    line-height: 1.7;
    margin-bottom: 20px;
    max-width: 560px;
  }

  .bio-tags {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-mute);
    letter-spacing: 0.06em;
    margin-bottom: 6px;
  }

  .bio-career {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-mute);
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .bio-card {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .bio-photo {
      width: 100%;
      height: 240px;
    }
  }
</style>
