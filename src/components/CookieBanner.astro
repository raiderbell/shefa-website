---
---
<div id="cookie-banner" class="cookie-banner" aria-live="polite" aria-label="Cookie consent">
  <p class="cookie-text">
    We may use cookies to improve your experience.
    <a href="/cookies" class="cookie-link">Cookie policy</a>
  </p>
  <div class="cookie-actions">
    <button id="cookie-accept" class="cookie-btn cookie-btn--accept">Accept</button>
    <button id="cookie-decline" class="cookie-btn cookie-btn--decline">Decline</button>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: var(--navy);
    border-top: 1px solid var(--border);
    padding: 14px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .cookie-banner.hidden {
    display: none;
  }

  .cookie-text {
    font-size: 0.8rem;
    color: var(--text-2);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cookie-link {
    color: var(--text-mute);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .cookie-link:hover {
    color: var(--text);
  }

  .cookie-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .cookie-btn {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    cursor: pointer;
    border: none;
    background: none;
    padding: 0;
  }

  .cookie-btn--accept {
    background: var(--gold);
    color: var(--navy);
    padding: 6px 14px;
    font-weight: 700;
  }

  .cookie-btn--accept:hover {
    opacity: 0.88;
  }

  .cookie-btn--decline {
    color: var(--text-mute);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cookie-btn--decline:hover {
    color: var(--text);
  }
</style>

<script>
  const STORAGE_KEY = 'shefa_cookie_consent';
  const banner = document.getElementById('cookie-banner');

  if (banner) {
    if (localStorage.getItem(STORAGE_KEY)) {
      banner.classList.add('hidden');
    }

    document.getElementById('cookie-accept')?.addEventListener('click', () => {
      localStorage.setItem(STORAGE_KEY, 'accepted');
      banner.classList.add('hidden');
    });

    document.getElementById('cookie-decline')?.addEventListener('click', () => {
      localStorage.setItem(STORAGE_KEY, 'declined');
      banner.classList.add('hidden');
    });
  }
</script>
