---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-left">
      <span class="footer-brand">Shefa Group</span>
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="/investment">Investment</a>
        <span class="sep">·</span>
        <a href="/advisory">Advisory</a>
        <span class="sep">·</span>
        <a href="/marketing">Marketing</a>
      </nav>
    </div>
    <div class="footer-right">
      <span>© {year} Shefa Group. All rights reserved.</span>
      <span class="sep">·</span>
      <a href="/contact">Contact</a>
      <span class="sep">·</span>
      <a href="/privacy">Privacy</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 40px 0;
    margin-top: auto;
  }

  .footer-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-brand {
    font-size: 0.8rem;
    color: var(--text-mute);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--text-mute);
  }

  .footer-nav a:hover {
    color: var(--text);
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--text-mute);
    flex-wrap: wrap;
  }

  .footer-right a:hover {
    color: var(--text);
  }

  .sep {
    color: var(--border-2);
  }
</style>
